{
  "$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v11/terminal-keeper.json",
  "theme": "tribe",
  "active": "default",
  "activateOnStartup": true,
  "keepExistingTerminals": false,
  "sessions": {
    "default": [
      {
        "name": "Terminal General",
        "autoExecuteCommands": false,
        "icon": "terminal",
        "color": "terminal.ansiWhite",
        "commands": []
      },
      {
        "name": "Run Pub Get",
        "autoExecuteCommands": false,
        "icon": "debug",
        "color": "terminal.ansiCyan",
        "commands": [
          "flutter pub get"
        ]
      },
      {
        "name": "Run Pub Upgrade",
        "autoExecuteCommands": false,
        "icon": "debug",
        "color": "terminal.ansiCyan",
        "commands": [
          "flutter pub upgrade"
        ]
      },
      {
        "name": "Run Flavor Dev",
        "autoExecuteCommands": false,
        "icon": "debug-alt",
        "color": "terminal.ansiCyan",
        "commands": [
          "flutter run --flavor dev -t lib/flavors/main_dev.dart"
        ]
      },
      {
        "name": "Run Flavor Staging",
        "autoExecuteCommands": false,
        "icon": "debug-alt",
        "color": "terminal.ansiYellow",
        "commands": [
          "flutter run --flavor staging -t lib/flavors/main_staging.dart"
        ]
      },
      {
        "name": "Run Flavor Prod",
        "autoExecuteCommands": false,
        "icon": "rocket",
        "color": "terminal.ansiRed",
        "commands": [
          "flutter run --flavor prod -t lib/flavors/main_prod.dart"
        ]
      },
      {
        "name": "Run Build Runner",
        "autoExecuteCommands": false,
        "icon": "tools",
        "color": "terminal.ansiMagenta",
        "commands": [
          "flutter pub run build_runner watch --delete-conflicting-outputs"
        ]
      },
      {
        "name": "Build APK Prod",
        "autoExecuteCommands": false,
        "icon": "package",
        "color": "terminal.ansiGreen",
        "commands": [
          "flutter build apk --flavor prod -t lib/flavors/main_prod.dart"
        ]
      },
      {
        "name": "Build App Bundle Prod",
        "autoExecuteCommands": false,
        "icon": "archive",
        "color": "terminal.ansiBlue",
        "commands": [
          "flutter build appbundle --flavor prod -t lib/flavors/main_prod.dart"
        ]
      },
      {
        "name": "Run Tests",
        "autoExecuteCommands": false,
        "icon": "debug-alt",
        "color": "terminal.ansiBlue",
        "commands": [
          "flutter test"
        ]
      },
      {
        "name": "Run Tests with Coverage",
        "autoExecuteCommands": false,
        "icon": "debug-alt",
        "color": "terminal.ansiMagenta",
        "commands": [
          "flutter test --coverage"
        ]
      },
      {
        "name": "Generate Coverage Report",
        "autoExecuteCommands": false,
        "icon": "debug-alt",
        "color": "terminal.ansiCyan",
        "commands": [
          "genhtml coverage/lcov.info -o coverage/html"
        ]
      },
      {
        "name": "Open Coverage Report",
        "autoExecuteCommands": false,
        "icon": "debug-alt",
        "color": "terminal.ansiYellow",
        "commands": [
          "open coverage/html/index.html"
        ]
      },
      {
        "name": "Run Golden Tests",
        "autoExecuteCommands": false,
        "icon": "eye",
        "color": "terminal.ansiCyan",
        "commands": [
          "fvm flutter test test/goldens/"
        ]
      },
      {
        "name": "Update Golden Tests",
        "autoExecuteCommands": false,
        "icon": "refresh",
        "color": "terminal.ansiYellow",
        "commands": [
          "fvm flutter test test/goldens/ --update-goldens"
        ]
      },
      {
        "name": "Coverage Script (Filtered)",
        "autoExecuteCommands": false,
        "icon": "graph",
        "color": "terminal.ansiGreen",
        "commands": [
          "./coverage.sh"
        ]
      },
      {
        "name": "Patrol Smoke Tests (Dev)",
        "autoExecuteCommands": false,
        "icon": "beaker",
        "color": "terminal.ansiRed",
        "commands": [
          "patrol test --target integration_test/smoke_test.dart --flavor dev"
        ]
      }
    ]
  }
}