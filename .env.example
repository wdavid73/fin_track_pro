# App Configuration
APP_NAME=FinTrack Pro
APP_SUFFIX=
BUNDLE_ID=com.fintrackpro

# API Configuration
API_BASE_URL=
API_TIMEOUT=30000

# Debug Configuration
ENABLE_LOGGING=false
ENABLE_DEBUG_BANNER=false
ENVIRONMENT=development

# Instructions
# 1. Copy this file to .env.dev, .env.staging, and .env.prod
# 2. Update the values according to your environment
# 3. Never commit the actual .env files to version control
