# Fastfile — FinTrack Pro (iOS)
#
# Lanes disponibles:
#   fastlane ios test            → Corre tests de Flutter
#   fastlane ios beta            → Build IPA + Firebase App Distribution
#   fastlane ios release         → Build IPA + TestFlight
#
# Secretos requeridos en GitHub Actions:
#   APP_STORE_CONNECT_API_KEY_ID        → Key ID de App Store Connect
#   APP_STORE_CONNECT_API_ISSUER_ID     → Issuer ID
#   APP_STORE_CONNECT_API_KEY_BASE64    → Llave privada en Base64
#   FIREBASE_APP_DIST_TOKEN             → Token de Firebase CLI
#   FIREBASE_IOS_APP_ID                 → App ID en Firebase (dev flavor)
#   MATCH_GIT_BASIC_AUTHORIZATION       → Token PAT para el repo de certificados
#   MATCH_PASSWORD                      → Password de cifrado de Match

default_platform(:ios)

platform :ios do
  before_all do
    # Configurar API Key de App Store Connect
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_BASE64"]),
    )
  end

  # ─── Lane: Test ──────────────────────────────────────────────────────────────
  desc "🧪 Run all Flutter tests"
  lane :test do
    sh("fvm flutter test --coverage")
  end

  # ─── Lane: Beta ──────────────────────────────────────────────────────────────
  desc "🚀 Build IPA (dev) and distribute via Firebase App Distribution"
  lane :beta do
    build_number = sh("git rev-list --count HEAD").strip.to_i

    # Sincronizar certificados y perfiles de aprovisionamiento con Match
    match(
      type: "adhoc",
      app_identifier: "com.fintrackpro.dev",  # Bundle ID del flavor dev
      readonly: true,
    )

    # Construir IPA con Flutter
    sh("fvm flutter build ipa --flavor dev -t lib/flavors/main_dev.dart --release --build-number #{build_number} --export-options-plist ios/ExportOptions-adhoc.plist")

    # Distribuir con Firebase App Distribution
    firebase_app_distribution(
      app: ENV["FIREBASE_IOS_APP_ID"],
      firebase_cli_token: ENV["FIREBASE_APP_DIST_TOKEN"],
      ipa_path: "build/ios/ipa/fin_track_pro.ipa",
      groups: "internal-testers",
      release_notes: sh("git log -1 --pretty=format:'%s'").strip,
    )
  end

  # ─── Lane: Release ───────────────────────────────────────────────────────────
  desc "📦 Build IPA and upload to TestFlight"
  lane :release do
    build_number = sh("git rev-list --count HEAD").strip.to_i
    version_name = sh("grep 'version:' ../../pubspec.yaml | cut -d' ' -f2 | cut -d'+' -f1").strip

    match(
      type: "appstore",
      app_identifier: "com.fintrackpro.app",  # Bundle ID prod
      readonly: true,
    )

    sh("fvm flutter build ipa --flavor prod -t lib/flavors/main_prod.dart --release --build-number #{build_number} --build-name #{version_name}")

    upload_to_testflight(
      ipa: "build/ios/ipa/fin_track_pro.ipa",
      skip_waiting_for_build_processing: true,
    )
  end
end
